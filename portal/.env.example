# Dữ liệu Kho tri thức. Bỏ trống thì dùng dữ liệu giả (chạy được khi chưa có backend).
# Đặt "/api/kb" để gọi backend thật qua BFF của portal (src/app/api/[...path]/route.ts).
NEXT_PUBLIC_KB_API_URL=

# Link "Mở Trợ lý"
NEXT_PUBLIC_CHAT_URL=http://localhost:3080

# BFF chuyển tiếp tới FastAPI ở đây (mặc định http://localhost:8000)
# BACKEND_URL=http://localhost:8000

# Bí mật dùng chung với backend (phải TRÙNG PORTAL_BFF_TOKEN trong backend/.env). Cho trang Tra cứu: BFF kèm email người
# đang đăng nhập để backend lọc quyền xem tài liệu. Tạo: python -c "import secrets;print(secrets.token_urlsafe(32))"
# PORTAL_BFF_TOKEN=

# CHỈ DEV, đặt trong .env.local (đã được git bỏ qua): Bearer JWT của một tài khoản admin trong bảng users của backend.
# Bỏ trống thì backend trả 401. Build production luôn bỏ qua biến này. Sẽ thay bằng token Zitadel (docs/06).
# API_DEV_TOKEN=
