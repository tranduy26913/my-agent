# Sao chép thành .env.local (đã .gitignore) rồi điền. Đổi biến thì phải khởi động lại `npm run dev`.

# Dữ liệu Kho tri thức. Bỏ trống thì dùng dữ liệu giả (chạy được khi chưa có backend).
# Đặt "/api/kb" để gọi backend thật qua BFF của portal (src/app/api/[...path]/route.ts).
NEXT_PUBLIC_KB_API_URL=

# Link "Mở Trợ lý"
NEXT_PUBLIC_CHAT_URL=http://localhost:3080

# BFF chuyển tiếp tới FastAPI ở đây (mặc định http://localhost:8000)
# BACKEND_URL=http://localhost:8000

# --- Đăng nhập Auth.js + Zitadel (docs/06 giai đoạn 5). Giá trị thật lấy từ infra/zitadel/out/generated.json
# (do infra/zitadel/bootstrap.py sinh ra). ---
AUTH_SECRET=             # chuỗi ngẫu nhiên >= 32 byte: `npx auth secret` hoặc `openssl rand -base64 33`
AUTH_URL=http://localhost:3100   # URL công khai của portal (production: https://portal.tranduyai.id.vn)
AUTH_ZITADEL_ISSUER=https://auth.tranduyai.id.vn
AUTH_ZITADEL_ID=         # clients.portal.clientId
AUTH_ZITADEL_SECRET=     # clients.portal.clientSecret
AUTH_ZITADEL_PROJECT_ID= # projectId (để `aud` của access token chứa project id)
# Chỉ dev, khi chưa có route tunnel tới Zitadel: server gọi Zitadel qua localhost và giả header Host.
# Lưu ý: trình duyệt vẫn phải tới được https://auth.tranduyai.id.vn để nhập mật khẩu.
# AUTH_ZITADEL_INTERNAL_URL=http://127.0.0.1:8180

# --- TẠM (xoá ở giai đoạn 6): người dùng giả để làm giao diện khi chưa đăng nhập được. Chỉ có tác dụng ở dev. ---
# Đặt cả hai thì portal bỏ qua Zitadel, dùng huy.do (admin) / binh.le, đổi vai trò ở menu người dùng.
# PORTAL_DEV_AUTH=1
# NEXT_PUBLIC_PORTAL_DEV_AUTH=1
# Với người dùng giả, BFF xưng danh bằng hai cầu nối cũ:
#  - PORTAL_BFF_TOKEN: bí mật dùng chung với backend (TRÙNG PORTAL_BFF_TOKEN trong backend/.env), cho trang Tra cứu.
#    Tạo: python -c "import secrets;print(secrets.token_urlsafe(32))"
#  - API_DEV_TOKEN: Bearer JWT HS256 của một admin trong bảng users của backend, cho /admin/kb.
# PORTAL_BFF_TOKEN=
# API_DEV_TOKEN=
