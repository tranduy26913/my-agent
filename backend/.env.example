# Sao chép thành .env rồi điền giá trị thật.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent
LLM_PROVIDER=claude            # claude | fake (offline, không cần key)
# ANTHROPIC_API_KEY đọc từ biến môi trường của tiến trình (SDK Anthropic), không đọc từ file này.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
RAG_LLM_MODEL=claude-sonnet-5-5
# --- Zitadel (docs/06). Rỗng = chưa bật OIDC: mọi Bearer token bị từ chối ---
OIDC_ISSUER=
OIDC_PROJECT_ID=
# Dev khi chưa có route tunnel: OIDC_INTERNAL_URL=http://127.0.0.1:8180 và OIDC_HOST_HEADER=auth.tranduyai.id.vn
OIDC_INTERNAL_URL=
OIDC_HOST_HEADER=
# Trang /admin/users: PAT của machine user `portal-admin-api` (infra/zitadel/out/generated.json, khoá portalAdminApiPat).
# Rỗng = trang báo 503. ZITADEL_ADMIN_URL rỗng = dùng OIDC_INTERNAL_URL rồi OIDC_ISSUER.
ZITADEL_ADMIN_PAT=
ZITADEL_ADMIN_URL=

# --- OCR (ADR-005) ---
# Mặc định tesseract (CPU, không cần gì thêm). Muốn PaddleOCR-VL: bật server `ocr-engine/run-paddle.sh`, rồi:
# OCR_ENGINE=paddleocr_vl
# OCR_PADDLEVL_URL=http://127.0.0.1:10001
# OCR_FALLBACK_ENGINE=tesseract   # server OCR tắt thì rơi về tesseract thay vì báo 503

# --- STT: ghi âm cuộc họp (ADR-006) ---
# Bật server `stt-engine/run.ps1` (cổng 10002), rồi đặt URL. Để trống = engine tắt, API báo 503.
# STT_WHISPER_URL=http://127.0.0.1:10002
