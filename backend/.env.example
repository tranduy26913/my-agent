# Sao chép thành .env rồi điền giá trị thật.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent
LLM_PROVIDER=claude            # claude | fake (offline, không cần key)
# ANTHROPIC_API_KEY đọc từ biến môi trường của tiến trình (SDK Anthropic), không đọc từ file này.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
RAG_LLM_MODEL=claude-sonnet-5-5
# Phải TRÙNG với KB_MCP_TOKEN trong librechat/.env. Tạo: python -c "import secrets;print(secrets.token_urlsafe(32))"
KB_MCP_TOKEN=
# Phải TRÙNG PORTAL_BFF_TOKEN trong portal/.env.local. Cho POST /api/kb/ask (BFF của portal gọi). Tạo bằng lệnh tương tự.
PORTAL_BFF_TOKEN=
